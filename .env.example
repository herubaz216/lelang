NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# Email via Brevo (disarankan — lebih andal untuk OTP)
# Daftar: https://app.brevo.com
BREVO_API_KEY=xkeysib-your_api_key_here
BREVO_FROM_EMAIL=noreply@amscorp.co.id
BREVO_FROM_NAME=E-Lelang

# SMTP fallback (opsional, dipakai jika BREVO_API_KEY kosong)
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USER=your_brevo_login_email@example.com
SMTP_PASS=your_brevo_smtp_key
SMTP_FROM=noreply@amscorp.co.id
SMTP_FROM_NAME=E-Lelang

# Opsional: secret hash OTP (default pakai service role key)
# OTP_SECRET=random-secret-string

# API cek NIK karyawan (registrasi bidder)
EMPLOYEE_API_BASE_URL=https://golangapi-j5iu.onrender.com
EMPLOYEE_API_KEY=your_employee_api_key_here
